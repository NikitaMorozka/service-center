<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ru.servicecenter.client.controller.MainController"
            prefWidth="1360" prefHeight="820" styleClass="root">
    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="4">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10"/>
            </padding>
            <Label text="Сервисный центр" styleClass="sidebar-title"/>
            <Label fx:id="userLabel" styleClass="sidebar-user"/>
            <Button fx:id="navRepairs" text="Заявки на ремонт" onAction="#showRepairs" styleClass="nav-button-active" maxWidth="Infinity"/>
            <Button fx:id="navHistory" text="История ремонта" onAction="#showHistory" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="navClients" text="Клиенты" onAction="#showClients" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="navUsers" text="Пользователи" onAction="#showUsers" styleClass="nav-button" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Выйти" onAction="#onLogout" styleClass="secondary-button" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane"/>
    </center>
</BorderPane>
